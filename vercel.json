{
  "redirects": [
    { "source": "/blog", "destination": "/", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/", "statusCode": 301 },
    { "source": "/podcast", "destination": "/", "statusCode": 301 },
    { "source": "/podcast/:path*", "destination": "/", "statusCode": 301 },
    { "source": "/faqs", "destination": "/#faq-heading", "statusCode": 301 },
    { "source": "/2026-google-review(.*)", "destination": "/", "statusCode": 301 },
    { "source": "/cart", "destination": "/", "statusCode": 301 },
    { "source": "/home", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    { "source": "/fraunces-latin.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/inter-latin.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
